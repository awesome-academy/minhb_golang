{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "REST API cho web đặt vé rạp chiếu phim.",
        "title": "Cinema Booking API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/health": {
            "get": {
                "description": "Returns 200 when the API can reach PostgreSQL, 503 otherwise.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.HealthResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/utils.APIErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "utils.APIErrorResponse": {
            "type": "object",
            "properties": {
                "errorCode": {
                    "type": "integer",
                    "example": 404
                },
                "errorMessage": {
                    "type": "string",
                    "example": "resource not found"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Nhập `Bearer {access token}`.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}