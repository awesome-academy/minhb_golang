# HTTP
HTTP_ADDR=:8080

# PostgreSQL (Docker Compose reads POSTGRES_*; the app reads DATABASE_URL)
POSTGRES_DB=cinema
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_PORT=5434
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
# DB_LOG_SQL=true logs every SQL statement; unset/false logs only errors and slow queries
DB_LOG_SQL=false

# Logging: LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=text|json (text: colored SQL log, json: plain)
LOG_LEVEL=debug
LOG_FORMAT=text

# Redis (Docker Compose reads REDIS_PORT; the app reads REDIS_URL)
REDIS_PORT=6380
REDIS_URL=redis://localhost:${REDIS_PORT}/0

# Admin session (SSR): TTL is the Redis key TTL and the cookie Max-Age
ADMIN_SESSION_TTL=8h
# ADMIN_COOKIE_SECURE=true only when serving admin over HTTPS
ADMIN_COOKIE_SECURE=false

# User API JWT (HS256): secret must be at least 32 characters; TTL is a Go duration
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=2h
