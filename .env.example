# HTTP
HTTP_ADDR=:8080

# PostgreSQL (Docker Compose reads POSTGRES_*; the app reads DATABASE_URL)
POSTGRES_DB=cinema
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_PORT=5434
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
# DB_LOG_SQL=true logs every SQL statement; unset/false logs only errors and slow queries
DB_LOG_SQL=false

# Logging: LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=text|json (text: colored SQL log, json: plain)
LOG_LEVEL=debug
LOG_FORMAT=text
